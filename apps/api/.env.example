# Copy to .env and adjust. Never commit real secrets.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://chamber:chamber@localhost:5432/chamber_dev?schema=public
# Origin(s) allowed to call the API with credentials (comma separated)
WEB_ORIGIN=http://localhost:5173
# Public URL of the web app (used in password reset links)
WEB_URL=http://localhost:5173
# Session lifetime
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
# Secure cookies require HTTPS; set to false only for local http development
COOKIE_SECURE=false
# Brute-force protection
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# Password reset token lifetime
PASSWORD_RESET_MINUTES=30
# Behind a reverse proxy (Caddy/nginx): trust X-Forwarded-For from one hop
TRUST_PROXY=false
# Rate limits (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=300
LOGIN_RATE_LIMIT_PER_MINUTE=10
# Observability: json in staging/production, pretty locally
LOG_FORMAT=pretty
LOG_LEVEL=log
# Log and count queries slower than this (SQL text only, never parameter values)
SLOW_QUERY_MS=300
# Enables GET /api/metrics for Prometheus (Bearer token, min 24 chars); unset = disabled
# METRICS_TOKEN=
