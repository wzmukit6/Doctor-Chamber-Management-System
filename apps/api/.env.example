# Copy to .env and adjust. Never commit real secrets.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://chamber:chamber@localhost:5432/chamber_dev?schema=public
# Origin(s) allowed to call the API with credentials (comma separated)
WEB_ORIGIN=http://localhost:5173
# Public URL of the web app (used in password reset links)
WEB_URL=http://localhost:5173
# Session lifetime
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
# Secure cookies require HTTPS; set to false only for local http development
COOKIE_SECURE=false
# Brute-force protection
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# Password reset token lifetime
PASSWORD_RESET_MINUTES=30
