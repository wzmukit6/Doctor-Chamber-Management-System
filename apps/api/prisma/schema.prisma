// Chamber Assistant — relational schema
// Phase 1 (Foundation): tenancy, identity, RBAC, sessions, audit, settings.
// Later phases add patients, appointments, clinical and billing entities
// (see docs/DATABASE.md for the full ERD).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Tenancy ───────────────────────────────

model Organization {
  id             String    @id @default(uuid()) @db.Uuid
  name           String    @db.VarChar(150)
  slug           String    @unique @db.VarChar(60)
  email          String?   @db.VarChar(254)
  phone          String?   @db.VarChar(20)
  address        String?   @db.VarChar(500)
  isActive       Boolean   @default(true) @map("is_active")
  isDemo         Boolean   @default(false) @map("is_demo")
  version        Int       @default(1)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedById    String?   @map("deleted_by") @db.Uuid
  deletionReason String?   @map("deletion_reason") @db.VarChar(500)

  chambers    Chamber[]
  memberships UserRole[]

  @@map("organizations")
}

model Chamber {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String    @db.VarChar(150)
  code           String    @db.VarChar(12)
  phone          String?   @db.VarChar(20)
  email          String?   @db.VarChar(254)
  address        String?   @db.VarChar(500)
  timezone       String    @default("Asia/Dhaka") @db.VarChar(64)
  isActive       Boolean   @default(true) @map("is_active")
  isDemo         Boolean   @default(false) @map("is_demo")
  version        Int       @default(1)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedById    String?   @map("deleted_by") @db.Uuid
  deletionReason String?   @map("deletion_reason") @db.VarChar(500)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  memberships  UserRole[]
  doctors      Doctor[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("chambers")
}

// ─────────────────────────────── Identity ──────────────────────────────

model User {
  id                String    @id @default(uuid()) @db.Uuid
  email             String    @unique @db.VarChar(254)
  fullName          String    @map("full_name") @db.VarChar(150)
  phone             String?   @db.VarChar(20)
  passwordHash      String    @map("password_hash") @db.VarChar(255)
  isActive          Boolean   @default(true) @map("is_active")
  isDemo            Boolean   @default(false) @map("is_demo")
  preferredLanguage String    @default("en") @map("preferred_language") @db.VarChar(5)
  mustChangePassword Boolean  @default(false) @map("must_change_password")
  failedLoginCount  Int       @default(0) @map("failed_login_count")
  lockedUntil       DateTime? @map("locked_until") @db.Timestamptz(3)
  lastLoginAt       DateTime? @map("last_login_at") @db.Timestamptz(3)
  passwordChangedAt DateTime? @map("password_changed_at") @db.Timestamptz(3)
  // MFA architecture (optional, not enforced yet)
  mfaEnabled        Boolean   @default(false) @map("mfa_enabled")
  mfaSecretEnc      String?   @map("mfa_secret_enc") @db.VarChar(255)
  version           Int       @default(1)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedById       String?   @map("deleted_by") @db.Uuid
  deletionReason    String?   @map("deletion_reason") @db.VarChar(500)

  memberships    UserRole[]           @relation("UserMemberships")
  doctorProfiles Doctor[]
  sessions       Session[]
  resetTokens    PasswordResetToken[]

  @@index([fullName])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(40)
  name        String   @db.VarChar(80)
  description String?  @db.VarChar(300)
  isSystem    Boolean  @default(true) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  permissions RolePermission[]
  memberships UserRole[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique @db.VarChar(80)
  group       String  @db.VarChar(40)
  description String? @db.VarChar(300)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// A user's membership: role + tenant scope. SUPER_ADMIN memberships have no chamber.
model UserRole {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  roleId         String   @map("role_id") @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  chamberId      String?  @map("chamber_id") @db.Uuid
  isActive       Boolean  @default(true) @map("is_active")
  createdById    String?  @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User          @relation("UserMemberships", fields: [userId], references: [id], onDelete: Cascade)
  role         Role          @relation(fields: [roleId], references: [id], onDelete: Restrict)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  chamber      Chamber?      @relation(fields: [chamberId], references: [id], onDelete: Restrict)
  sessions     Session[]

  @@unique([userId, chamberId])
  @@index([chamberId])
  @@index([organizationId])
  @@map("user_roles")
}

/// Clinical profile of a doctor inside a chamber.
model Doctor {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  chamberId       String   @map("chamber_id") @db.Uuid
  qualifications  String?  @db.VarChar(300)
  specialty       String?  @db.VarChar(150)
  registrationNo  String?  @map("registration_no") @db.VarChar(80)
  consultationFee Decimal? @map("consultation_fee") @db.Decimal(12, 2)
  followUpFee     Decimal? @map("follow_up_fee") @db.Decimal(12, 2)
  bio             String?  @db.VarChar(1000)
  signatureFileId String?  @map("signature_file_id") @db.Uuid
  isActive        Boolean  @default(true) @map("is_active")
  version         Int      @default(1)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  chamber Chamber @relation(fields: [chamberId], references: [id], onDelete: Restrict)

  @@unique([userId, chamberId])
  @@index([chamberId])
  @@map("doctors")
}

// ───────────────────────────── Sessions ─────────────────────────────

model Session {
  id            String    @id @default(uuid()) @db.Uuid
  tokenHash     String    @unique @map("token_hash") @db.Char(64)
  csrfHash      String    @map("csrf_hash") @db.Char(64)
  userId        String    @map("user_id") @db.Uuid
  membershipId  String    @map("membership_id") @db.Uuid
  ipAddress     String?   @map("ip_address") @db.VarChar(64)
  userAgent     String?   @map("user_agent") @db.VarChar(300)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  idleExpiresAt DateTime  @map("idle_expires_at") @db.Timestamptz(3)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason String?   @map("revoked_reason") @db.VarChar(100)

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership UserRole @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model PasswordResetToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.Char(64)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt      DateTime? @map("used_at") @db.Timestamptz(3)
  requestIp   String?   @map("request_ip") @db.VarChar(64)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ───────────────────────────── Audit & settings ─────────────────────────────

/// Append-only, hash-chained audit trail. UPDATE/DELETE are blocked by a DB trigger.
model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  seq            BigInt   @unique @default(autoincrement())
  organizationId String?  @map("organization_id") @db.Uuid
  chamberId      String?  @map("chamber_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  userName       String?  @map("user_name") @db.VarChar(150)
  role           String?  @db.VarChar(40)
  action         String   @db.VarChar(80)
  resourceType   String   @map("resource_type") @db.VarChar(60)
  resourceId     String?  @map("resource_id") @db.VarChar(64)
  oldValue       Json?    @map("old_value")
  newValue       Json?    @map("new_value")
  reason         String?  @db.VarChar(500)
  ipAddress      String?  @map("ip_address") @db.VarChar(64)
  userAgent      String?  @map("user_agent") @db.VarChar(300)
  sessionId      String?  @map("session_id") @db.Uuid
  prevHash       String?  @map("prev_hash") @db.Char(64)
  hash           String   @db.Char(64)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([chamberId, createdAt])
  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@index([resourceType, resourceId])
  @@index([action])
  @@map("audit_logs")
}

enum SettingScope {
  PLATFORM
  ORGANIZATION
  CHAMBER
  USER
}

model Setting {
  id          String       @id @default(uuid()) @db.Uuid
  scope       SettingScope
  scopeId     String?      @map("scope_id") @db.Uuid
  key         String       @db.VarChar(100)
  value       Json
  version     Int          @default(1)
  updatedById String?      @map("updated_by") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([scope, scopeId, key])
  @@map("settings")
}
