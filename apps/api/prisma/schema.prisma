// Chamber Assistant — relational schema
// Phase 1 (Foundation): tenancy, identity, RBAC, sessions, audit, settings.
// Later phases add patients, appointments, clinical and billing entities
// (see docs/DATABASE.md for the full ERD).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Tenancy ───────────────────────────────

model Organization {
  id             String    @id @default(uuid()) @db.Uuid
  name           String    @db.VarChar(150)
  slug           String    @unique @db.VarChar(60)
  email          String?   @db.VarChar(254)
  phone          String?   @db.VarChar(20)
  address        String?   @db.VarChar(500)
  isActive       Boolean   @default(true) @map("is_active")
  isDemo         Boolean   @default(false) @map("is_demo")
  version        Int       @default(1)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedById    String?   @map("deleted_by") @db.Uuid
  deletionReason String?   @map("deletion_reason") @db.VarChar(500)

  chambers    Chamber[]
  memberships UserRole[]

  @@map("organizations")
}

model Chamber {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String    @db.VarChar(150)
  code           String    @db.VarChar(12)
  phone          String?   @db.VarChar(20)
  email          String?   @db.VarChar(254)
  address        String?   @db.VarChar(500)
  timezone       String    @default("Asia/Dhaka") @db.VarChar(64)
  isActive       Boolean   @default(true) @map("is_active")
  isDemo         Boolean   @default(false) @map("is_demo")
  version        Int       @default(1)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedById    String?   @map("deleted_by") @db.Uuid
  deletionReason String?   @map("deletion_reason") @db.VarChar(500)

  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  memberships           UserRole[]
  doctors               Doctor[]
  patients              Patient[]
  appointments          Appointment[]
  consultations         Consultation[]
  vitalDefinitions      VitalDefinition[]
  complaintCatalog      ComplaintCatalog[]
  investigationCatalog  InvestigationCatalog[]
  diagnosisCatalog      DiagnosisCatalog[]
  medicines             Medicine[]
  prescriptions         Prescription[]
  prescriptionTemplates PrescriptionTemplate[]
  invoices              Invoice[]
  feeItems              FeeItem[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("chambers")
}

// ─────────────────────────────── Identity ──────────────────────────────

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  email              String    @unique @db.VarChar(254)
  fullName           String    @map("full_name") @db.VarChar(150)
  phone              String?   @db.VarChar(20)
  passwordHash       String    @map("password_hash") @db.VarChar(255)
  isActive           Boolean   @default(true) @map("is_active")
  isDemo             Boolean   @default(false) @map("is_demo")
  preferredLanguage  String    @default("en") @map("preferred_language") @db.VarChar(5)
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  failedLoginCount   Int       @default(0) @map("failed_login_count")
  lockedUntil        DateTime? @map("locked_until") @db.Timestamptz(3)
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz(3)
  passwordChangedAt  DateTime? @map("password_changed_at") @db.Timestamptz(3)
  // MFA architecture (optional, not enforced yet)
  mfaEnabled         Boolean   @default(false) @map("mfa_enabled")
  mfaSecretEnc       String?   @map("mfa_secret_enc") @db.VarChar(255)
  version            Int       @default(1)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedById        String?   @map("deleted_by") @db.Uuid
  deletionReason     String?   @map("deletion_reason") @db.VarChar(500)

  memberships     UserRole[]           @relation("UserMemberships")
  doctorProfiles  Doctor[]
  sessions        Session[]
  resetTokens     PasswordResetToken[]
  patientsCreated Patient[]            @relation("PatientCreatedBy")

  @@index([fullName])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(40)
  name        String   @db.VarChar(80)
  description String?  @db.VarChar(300)
  isSystem    Boolean  @default(true) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  permissions RolePermission[]
  memberships UserRole[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique @db.VarChar(80)
  group       String  @db.VarChar(40)
  description String? @db.VarChar(300)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// A user's membership: role + tenant scope. SUPER_ADMIN memberships have no chamber.
model UserRole {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  roleId         String   @map("role_id") @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  chamberId      String?  @map("chamber_id") @db.Uuid
  isActive       Boolean  @default(true) @map("is_active")
  createdById    String?  @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User          @relation("UserMemberships", fields: [userId], references: [id], onDelete: Cascade)
  role         Role          @relation(fields: [roleId], references: [id], onDelete: Restrict)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  chamber      Chamber?      @relation(fields: [chamberId], references: [id], onDelete: Restrict)
  sessions     Session[]

  @@unique([userId, chamberId])
  @@index([chamberId])
  @@index([organizationId])
  @@map("user_roles")
}

/// Clinical profile of a doctor inside a chamber.
model Doctor {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  chamberId          String   @map("chamber_id") @db.Uuid
  qualifications     String?  @db.VarChar(300)
  specialty          String?  @db.VarChar(150)
  registrationNo     String?  @map("registration_no") @db.VarChar(80)
  consultationFee    Decimal? @map("consultation_fee") @db.Decimal(12, 2)
  followUpFee        Decimal? @map("follow_up_fee") @db.Decimal(12, 2)
  reportReviewFee    Decimal? @map("report_review_fee") @db.Decimal(12, 2)
  bio                String?  @db.VarChar(1000)
  signatureFileId    String?  @map("signature_file_id") @db.Uuid
  /// Signature image as a data URL (PNG/JPEG/WebP, size-limited), printed on prescriptions.
  signatureDataUrl   String?  @map("signature_data_url")
  prescriptionFooter String?  @map("prescription_footer") @db.VarChar(300)
  isActive           Boolean  @default(true) @map("is_active")
  version            Int      @default(1)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  slotMinutes      Int? @map("slot_minutes")
  maxDailyPatients Int? @map("max_daily_patients")

  user              User                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  chamber           Chamber                  @relation(fields: [chamberId], references: [id], onDelete: Restrict)
  schedule          DoctorScheduleWindow[]
  appointments      Appointment[]
  consultations     Consultation[]
  prescriptions     Prescription[]
  favoriteMedicines DoctorMedicineFavorite[]
  templates         PrescriptionTemplate[]
  invoices          Invoice[]

  @@unique([userId, chamberId])
  @@index([chamberId])
  @@map("doctors")
}

// ───────────────────────────── Sessions ─────────────────────────────

model Session {
  id            String    @id @default(uuid()) @db.Uuid
  tokenHash     String    @unique @map("token_hash") @db.Char(64)
  csrfHash      String    @map("csrf_hash") @db.Char(64)
  userId        String    @map("user_id") @db.Uuid
  membershipId  String    @map("membership_id") @db.Uuid
  ipAddress     String?   @map("ip_address") @db.VarChar(64)
  userAgent     String?   @map("user_agent") @db.VarChar(300)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  idleExpiresAt DateTime  @map("idle_expires_at") @db.Timestamptz(3)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason String?   @map("revoked_reason") @db.VarChar(100)

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership UserRole @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  requestIp String?   @map("request_ip") @db.VarChar(64)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ───────────────────────────── Audit & settings ─────────────────────────────

/// Append-only, hash-chained audit trail. UPDATE/DELETE are blocked by a DB trigger.
model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  seq            BigInt   @unique @default(autoincrement())
  organizationId String?  @map("organization_id") @db.Uuid
  chamberId      String?  @map("chamber_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  userName       String?  @map("user_name") @db.VarChar(150)
  role           String?  @db.VarChar(40)
  action         String   @db.VarChar(80)
  resourceType   String   @map("resource_type") @db.VarChar(60)
  resourceId     String?  @map("resource_id") @db.VarChar(64)
  oldValue       Json?    @map("old_value")
  newValue       Json?    @map("new_value")
  reason         String?  @db.VarChar(500)
  ipAddress      String?  @map("ip_address") @db.VarChar(64)
  userAgent      String?  @map("user_agent") @db.VarChar(300)
  sessionId      String?  @map("session_id") @db.Uuid
  prevHash       String?  @map("prev_hash") @db.Char(64)
  hash           String   @db.Char(64)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([chamberId, createdAt])
  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@index([resourceType, resourceId])
  @@index([action])
  @@map("audit_logs")
}

enum SettingScope {
  PLATFORM
  ORGANIZATION
  CHAMBER
  USER
}

model Setting {
  id          String       @id @default(uuid()) @db.Uuid
  scope       SettingScope
  scopeId     String?      @map("scope_id") @db.Uuid
  key         String       @db.VarChar(100)
  value       Json
  version     Int          @default(1)
  updatedById String?      @map("updated_by") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([scope, scopeId, key])
  @@map("settings")
}

// ─────────────────────────────── Patients (Phase 2) ───────────────────────────────

enum Gender {
  MALE
  FEMALE
  OTHER
  UNDISCLOSED
}

enum AllergySeverity {
  MILD
  MODERATE
  SEVERE
  UNKNOWN
}

/// A patient registered in a chamber. The patient code is unique per chamber (e.g. DHN-00042).
model Patient {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  chamberId      String    @map("chamber_id") @db.Uuid
  patientCode    String    @map("patient_code") @db.VarChar(24)
  fullName       String    @map("full_name") @db.VarChar(150)
  gender         Gender
  dateOfBirth    DateTime? @map("date_of_birth") @db.Date
  dobEstimated   Boolean   @default(false) @map("dob_estimated")
  bloodGroup     String?   @map("blood_group") @db.VarChar(3)
  phone          String?   @db.VarChar(20)
  /// Digits-only local form of the phone (e.g. 01711000000) for fast search.
  phoneSearch    String?   @map("phone_search") @db.VarChar(20)
  email          String?   @db.VarChar(254)
  address        String?   @db.VarChar(500)
  occupation     String?   @db.VarChar(100)
  nationality    String?   @db.VarChar(60)
  photoFileId    String?   @map("photo_file_id") @db.Uuid
  isDemo         Boolean   @default(false) @map("is_demo")
  version        Int       @default(1)
  createdById    String?   @map("created_by") @db.Uuid
  updatedById    String?   @map("updated_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedById    String?   @map("deleted_by") @db.Uuid
  deletionReason String?   @map("deletion_reason") @db.VarChar(500)

  chamber        Chamber                @relation(fields: [chamberId], references: [id], onDelete: Restrict)
  createdBy      User?                  @relation("PatientCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  contacts       PatientContact[]
  allergies      PatientAllergy[]
  medicalHistory PatientMedicalHistory?
  recentViews    PatientRecentView[]
  appointments   Appointment[]
  consultations  Consultation[]
  prescriptions  Prescription[]
  invoices       Invoice[]

  @@unique([chamberId, patientCode])
  @@index([chamberId, createdAt])
  @@index([chamberId, phoneSearch])
  @@index([chamberId, dateOfBirth])
  @@index([chamberId, email])
  @@map("patients")
}

/// Emergency / alternate contacts of a patient.
model PatientContact {
  id        String   @id @default(uuid()) @db.Uuid
  patientId String   @map("patient_id") @db.Uuid
  name      String   @db.VarChar(150)
  relation  String?  @db.VarChar(60)
  phone     String   @db.VarChar(20)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@map("patient_contacts")
}

model PatientAllergy {
  id             String          @id @default(uuid()) @db.Uuid
  patientId      String          @map("patient_id") @db.Uuid
  allergen       String          @db.VarChar(120)
  reaction       String?         @db.VarChar(200)
  severity       AllergySeverity @default(UNKNOWN)
  createdById    String?         @map("created_by") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt      DateTime?       @map("deleted_at") @db.Timestamptz(3)
  deletedById    String?         @map("deleted_by") @db.Uuid
  deletionReason String?         @map("deletion_reason") @db.VarChar(500)

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@map("patient_allergies")
}

/// Patient-reported medical background (1:1 with patient), versioned for concurrent edits.
model PatientMedicalHistory {
  id                 String   @id @default(uuid()) @db.Uuid
  patientId          String   @unique @map("patient_id") @db.Uuid
  existingConditions String?  @map("existing_conditions") @db.VarChar(2000)
  previousSurgeries  String?  @map("previous_surgeries") @db.VarChar(2000)
  currentMedications String?  @map("current_medications") @db.VarChar(2000)
  relevantHistory    String?  @map("relevant_history") @db.VarChar(4000)
  familyHistory      String?  @map("family_history") @db.VarChar(2000)
  lifestyle          String?  @db.VarChar(2000)
  version            Int      @default(1)
  updatedById        String?  @map("updated_by") @db.Uuid
  updatedByName      String?  @map("updated_by_name") @db.VarChar(150)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("patient_medical_histories")
}

/// Per-chamber counter used to issue sequential patient codes atomically.
model PatientCodeSequence {
  chamberId String @id @map("chamber_id") @db.Uuid
  lastValue Int    @default(0) @map("last_value")

  @@map("patient_code_sequences")
}

/// "Recent patients" per user (spec §6).
model PatientRecentView {
  userId    String   @map("user_id") @db.Uuid
  patientId String   @map("patient_id") @db.Uuid
  chamberId String   @map("chamber_id") @db.Uuid
  viewedAt  DateTime @default(now()) @map("viewed_at") @db.Timestamptz(3)

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@id([userId, patientId])
  @@index([userId, chamberId, viewedAt])
  @@map("patient_recent_views")
}

// ─────────────────────────── Appointments & queue (Phase 3) ───────────────────────────

enum AppointmentStatus {
  BOOKED
  CONFIRMED
  CHECKED_IN
  WAITING
  IN_CONSULTATION
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum VisitType {
  NEW
  FOLLOW_UP
  REPORT_REVIEW
}

enum AppointmentHistoryAction {
  CREATED
  STATUS_CHANGED
  RESCHEDULED
  UPDATED
}

/// Weekly availability window of a doctor (chamber-local wall-clock times).
model DoctorScheduleWindow {
  id        String   @id @default(uuid()) @db.Uuid
  doctorId  String   @map("doctor_id") @db.Uuid
  weekday   Int      @db.SmallInt
  startTime String   @map("start_time") @db.VarChar(5)
  endTime   String   @map("end_time") @db.VarChar(5)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, weekday])
  @@map("doctor_schedule_windows")
}

/// Double booking is prevented by exclusion constraints (see migration SQL).
model Appointment {
  id              String            @id @default(uuid()) @db.Uuid
  organizationId  String            @map("organization_id") @db.Uuid
  chamberId       String            @map("chamber_id") @db.Uuid
  patientId       String            @map("patient_id") @db.Uuid
  doctorId        String            @map("doctor_id") @db.Uuid
  startsAt        DateTime          @map("starts_at") @db.Timestamptz(3)
  endsAt          DateTime          @map("ends_at") @db.Timestamptz(3)
  status          AppointmentStatus @default(BOOKED)
  visitType       VisitType         @default(NEW) @map("visit_type")
  reason          String?           @db.VarChar(300)
  notes           String?           @db.VarChar(1000)
  isWalkIn        Boolean           @default(false) @map("is_walk_in")
  isOverbooked    Boolean           @default(false) @map("is_overbooked")
  checkedInAt     DateTime?         @map("checked_in_at") @db.Timestamptz(3)
  queuedAt        DateTime?         @map("queued_at") @db.Timestamptz(3)
  startedAt       DateTime?         @map("started_at") @db.Timestamptz(3)
  completedAt     DateTime?         @map("completed_at") @db.Timestamptz(3)
  cancelledAt     DateTime?         @map("cancelled_at") @db.Timestamptz(3)
  cancelledById   String?           @map("cancelled_by") @db.Uuid
  cancelledReason String?           @map("cancelled_reason") @db.VarChar(500)
  isDemo          Boolean           @default(false) @map("is_demo")
  version         Int               @default(1)
  createdById     String?           @map("created_by") @db.Uuid
  createdByName   String?           @map("created_by_name") @db.VarChar(150)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  chamber      Chamber                    @relation(fields: [chamberId], references: [id], onDelete: Restrict)
  patient      Patient                    @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor       Doctor                     @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  history      AppointmentStatusHistory[]
  token        QueueToken?
  consultation Consultation?
  vitals       ConsultationVital[]
  invoices     Invoice[]

  @@index([chamberId, startsAt])
  @@index([doctorId, startsAt])
  @@index([patientId, startsAt])
  @@index([chamberId, status])
  @@map("appointments")
}

model AppointmentStatusHistory {
  id            String                   @id @default(uuid()) @db.Uuid
  appointmentId String                   @map("appointment_id") @db.Uuid
  action        AppointmentHistoryAction
  fromStatus    AppointmentStatus?       @map("from_status")
  toStatus      AppointmentStatus?       @map("to_status")
  details       Json?
  reason        String?                  @db.VarChar(500)
  changedById   String?                  @map("changed_by") @db.Uuid
  changedByName String?                  @map("changed_by_name") @db.VarChar(150)
  createdAt     DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId, createdAt])
  @@map("appointment_status_history")
}

/// Daily token issued at check-in (spec §8).
model QueueToken {
  id            String    @id @default(uuid()) @db.Uuid
  chamberId     String    @map("chamber_id") @db.Uuid
  doctorId      String    @map("doctor_id") @db.Uuid
  appointmentId String    @unique @map("appointment_id") @db.Uuid
  queueDate     DateTime  @map("queue_date") @db.Date
  /// "ALL" for chamber-wide numbering, otherwise the doctor id.
  scopeKey      String    @map("scope_key") @db.VarChar(40)
  tokenNumber   Int       @map("token_number")
  label         String    @db.VarChar(12)
  onHold        Boolean   @default(false) @map("on_hold")
  calledAt      DateTime? @map("called_at") @db.Timestamptz(3)
  callCount     Int       @default(0) @map("call_count")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@unique([chamberId, scopeKey, queueDate, tokenNumber])
  @@index([chamberId, queueDate])
  @@map("queue_tokens")
}

model QueueTokenSequence {
  chamberId String   @map("chamber_id") @db.Uuid
  scopeKey  String   @map("scope_key") @db.VarChar(40)
  queueDate DateTime @map("queue_date") @db.Date
  lastValue Int      @default(0) @map("last_value")

  @@id([chamberId, scopeKey, queueDate])
  @@map("queue_token_sequences")
}

// ─────────────────────────── Clinical workflow (Phase 4) ───────────────────────────

enum ConsultationStatus {
  DRAFT
  FINALIZED
  CANCELLED
}

enum DiagnosisCertainty {
  CONFIRMED
  PROVISIONAL
  DIFFERENTIAL
}

enum InvestigationPriority {
  ROUTINE
  URGENT
  STAT
}

enum VitalType {
  NUMBER
  BLOOD_PRESSURE
  TEXT
}

enum ConsultationNoteType {
  CLINICAL
  ADDENDUM
}

/// Diagnosis master (spec §16). chamber_id NULL = platform-wide entry. ICD-compatible code.
model DiagnosisCatalog {
  id          String   @id @default(uuid()) @db.Uuid
  chamberId   String?  @map("chamber_id") @db.Uuid
  name        String   @db.VarChar(200)
  code        String?  @db.VarChar(20)
  codeSystem  String   @default("ICD-10") @map("code_system") @db.VarChar(20)
  category    String?  @db.VarChar(100)
  description String?  @db.VarChar(1000)
  keywords    String?  @db.VarChar(300)
  isActive    Boolean  @default(true) @map("is_active")
  createdById String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  chamber Chamber?                @relation(fields: [chamberId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "diagnoses_chamber_fk")
  usages  ConsultationDiagnosis[]

  @@index([chamberId])
  @@map("diagnoses")
}

/// Investigation / test master (spec §17).
model InvestigationCatalog {
  id           String   @id @default(uuid()) @db.Uuid
  chamberId    String?  @map("chamber_id") @db.Uuid
  name         String   @db.VarChar(200)
  shortName    String?  @map("short_name") @db.VarChar(40)
  category     String?  @db.VarChar(100)
  sampleType   String?  @map("sample_type") @db.VarChar(60)
  instructions String?  @db.VarChar(500)
  isActive     Boolean  @default(true) @map("is_active")
  createdById  String?  @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  chamber  Chamber?                    @relation(fields: [chamberId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "investigations_chamber_fk")
  usages   ConsultationInvestigation[]
  feeItems FeeItem[]

  @@index([chamberId])
  @@map("investigations")
}

/// Predefined chief complaints (spec §9 "searchable predefined complaints").
model ComplaintCatalog {
  id          String   @id @default(uuid()) @db.Uuid
  chamberId   String?  @map("chamber_id") @db.Uuid
  name        String   @db.VarChar(200)
  isActive    Boolean  @default(true) @map("is_active")
  createdById String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  chamber Chamber?              @relation(fields: [chamberId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "complaints_chamber_fk")
  usages  ConsultationSymptom[]

  @@index([chamberId])
  @@map("complaints")
}

/// Configurable examination fields (spec §9: "Do not hard-code only these fields").
model VitalDefinition {
  id        String    @id @default(uuid()) @db.Uuid
  chamberId String?   @map("chamber_id") @db.Uuid
  key       String    @db.VarChar(40)
  label     String    @db.VarChar(60)
  unit      String?   @db.VarChar(20)
  type      VitalType @default(NUMBER)
  minValue  Decimal?  @map("min_value") @db.Decimal(10, 2)
  maxValue  Decimal?  @map("max_value") @db.Decimal(10, 2)
  decimals  Int       @default(0) @db.SmallInt
  sortOrder Int       @default(100) @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  chamber Chamber?            @relation(fields: [chamberId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "vital_definitions_chamber_fk")
  values  ConsultationVital[]

  @@map("vital_definitions")
}

model Consultation {
  id                   String             @id @default(uuid()) @db.Uuid
  organizationId       String             @map("organization_id") @db.Uuid
  chamberId            String             @map("chamber_id") @db.Uuid
  patientId            String             @map("patient_id") @db.Uuid
  doctorId             String             @map("doctor_id") @db.Uuid
  appointmentId        String?            @unique @map("appointment_id") @db.Uuid
  status               ConsultationStatus @default(DRAFT)
  visitNumber          Int                @map("visit_number")
  presentIllness       String?            @map("present_illness") @db.VarChar(4000)
  pastHistory          String?            @map("past_history") @db.VarChar(4000)
  familyHistory        String?            @map("family_history") @db.VarChar(2000)
  medicationHistory    String?            @map("medication_history") @db.VarChar(2000)
  otherHistory         String?            @map("other_history") @db.VarChar(2000)
  examinationNotes     String?            @map("examination_notes") @db.VarChar(4000)
  followUpDate         DateTime?          @map("follow_up_date") @db.Date
  followUpInstructions String?            @map("follow_up_instructions") @db.VarChar(500)
  startedAt            DateTime           @default(now()) @map("started_at") @db.Timestamptz(3)
  finalizedAt          DateTime?          @map("finalized_at") @db.Timestamptz(3)
  finalizedById        String?            @map("finalized_by") @db.Uuid
  finalizedByName      String?            @map("finalized_by_name") @db.VarChar(150)
  cancelledAt          DateTime?          @map("cancelled_at") @db.Timestamptz(3)
  cancelledReason      String?            @map("cancelled_reason") @db.VarChar(500)
  isDemo               Boolean            @default(false) @map("is_demo")
  version              Int                @default(1)
  createdById          String?            @map("created_by") @db.Uuid
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  chamber        Chamber                     @relation(fields: [chamberId], references: [id], onDelete: Restrict)
  patient        Patient                     @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor         Doctor                      @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  appointment    Appointment?                @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  symptoms       ConsultationSymptom[]
  vitals         ConsultationVital[]
  diagnoses      ConsultationDiagnosis[]
  investigations ConsultationInvestigation[]
  notes          ConsultationNote[]
  prescription   Prescription?

  @@index([chamberId, startedAt])
  @@index([patientId, startedAt])
  @@index([doctorId, startedAt])
  @@index([chamberId, followUpDate])
  @@map("consultations")
}

model ConsultationSymptom {
  id             String   @id @default(uuid()) @db.Uuid
  consultationId String   @map("consultation_id") @db.Uuid
  complaintId    String?  @map("complaint_id") @db.Uuid
  text           String   @db.VarChar(200)
  duration       String?  @db.VarChar(60)
  note           String?  @db.VarChar(300)
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  consultation Consultation      @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  complaint    ComplaintCatalog? @relation(fields: [complaintId], references: [id], onDelete: SetNull)

  @@index([consultationId])
  @@map("consultation_symptoms")
}

/// Vitals. Recorded before the consultation they carry only appointment_id (e.g. by an assistant);
/// the consultation adopts them when it starts.
model ConsultationVital {
  id             String   @id @default(uuid()) @db.Uuid
  consultationId String?  @map("consultation_id") @db.Uuid
  appointmentId  String?  @map("appointment_id") @db.Uuid
  definitionId   String   @map("definition_id") @db.Uuid
  valueText      String   @map("value_text") @db.VarChar(40)
  valueNumber    Decimal? @map("value_number") @db.Decimal(10, 2)
  valueNumber2   Decimal? @map("value_number2") @db.Decimal(10, 2)
  recordedById   String?  @map("recorded_by") @db.Uuid
  recordedByName String?  @map("recorded_by_name") @db.VarChar(150)
  recordedAt     DateTime @default(now()) @map("recorded_at") @db.Timestamptz(3)

  consultation Consultation?   @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  appointment  Appointment?    @relation(fields: [appointmentId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "consultation_vitals_appointment_fk")
  definition   VitalDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict)

  @@unique([consultationId, definitionId])
  @@unique([appointmentId, definitionId])
  @@map("consultation_vitals")
}

model ConsultationDiagnosis {
  id             String             @id @default(uuid()) @db.Uuid
  consultationId String             @map("consultation_id") @db.Uuid
  diagnosisId    String?            @map("diagnosis_id") @db.Uuid
  name           String             @db.VarChar(200)
  code           String?            @db.VarChar(20)
  isPrimary      Boolean            @default(false) @map("is_primary")
  certainty      DiagnosisCertainty @default(CONFIRMED)
  note           String?            @db.VarChar(300)
  sortOrder      Int                @default(0) @map("sort_order")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  consultation Consultation      @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  diagnosis    DiagnosisCatalog? @relation(fields: [diagnosisId], references: [id], onDelete: SetNull)

  @@index([consultationId])
  @@index([diagnosisId])
  @@map("consultation_diagnoses")
}

model ConsultationInvestigation {
  id              String                @id @default(uuid()) @db.Uuid
  consultationId  String                @map("consultation_id") @db.Uuid
  investigationId String?               @map("investigation_id") @db.Uuid
  name            String                @db.VarChar(200)
  instructions    String?               @db.VarChar(300)
  priority        InvestigationPriority @default(ROUTINE)
  sortOrder       Int                   @default(0) @map("sort_order")
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  consultation  Consultation          @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  investigation InvestigationCatalog? @relation(fields: [investigationId], references: [id], onDelete: SetNull)

  @@index([consultationId])
  @@index([investigationId])
  @@map("consultation_investigations")
}

/// CLINICAL: the doctor's private note (one per consultation, editable while DRAFT).
/// ADDENDUM: append-only notes added after finalization.
model ConsultationNote {
  id             String               @id @default(uuid()) @db.Uuid
  consultationId String               @map("consultation_id") @db.Uuid
  type           ConsultationNoteType
  text           String               @db.VarChar(4000)
  createdById    String?              @map("created_by") @db.Uuid
  createdByName  String?              @map("created_by_name") @db.VarChar(150)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@index([consultationId, type])
  @@map("consultation_notes")
}

// ───────────────────────── Prescriptions (Phase 5) ─────────────────────────

enum MedicineForm {
  TABLET
  CAPSULE
  SYRUP
  SUSPENSION
  DROPS
  INJECTION
  INHALER
  NEBULIZER_SOLUTION
  CREAM
  OINTMENT
  GEL
  LOTION
  EYE_DROPS
  EAR_DROPS
  NASAL_SPRAY
  SACHET
  SUPPOSITORY
  MOUTHWASH
  OTHER
}

enum MedicineRoute {
  ORAL
  TOPICAL
  INHALATION
  IV
  IM
  SC
  SUBLINGUAL
  NASAL
  OPHTHALMIC
  OTIC
  RECTAL
  VAGINAL
  OTHER
}

enum MealInstruction {
  BEFORE_MEAL
  AFTER_MEAL
  WITH_MEAL
  EMPTY_STOMACH
  BEDTIME
}

enum DurationUnit {
  DAYS
  WEEKS
  MONTHS
  CONTINUE
}

enum PrescriptionStatus {
  DRAFT
  FINALIZED
  REVISED
  CANCELLED
}

enum PrescriptionVersionStatus {
  DRAFT
  FINALIZED
  SUPERSEDED
  DISCARDED
}

/// Medicine master (spec §15). chamber_id NULL = global entry.
model Medicine {
  id                String         @id @default(uuid()) @db.Uuid
  chamberId         String?        @map("chamber_id") @db.Uuid
  genericName       String         @map("generic_name") @db.VarChar(200)
  brandName         String?        @map("brand_name") @db.VarChar(200)
  manufacturer      String?        @db.VarChar(150)
  form              MedicineForm
  strength          String?        @db.VarChar(80)
  category          String?        @db.VarChar(100)
  route             MedicineRoute?
  defaultDose       String?        @map("default_dose") @db.VarChar(60)
  commonFrequencies String[]       @default([]) @map("common_frequencies") @db.VarChar(60)
  commonDurations   String[]       @default([]) @map("common_durations") @db.VarChar(60)
  keywords          String?        @db.VarChar(300)
  isActive          Boolean        @default(true) @map("is_active")
  createdById       String?        @map("created_by") @db.Uuid
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  chamber   Chamber?                 @relation(fields: [chamberId], references: [id], onDelete: Restrict)
  favorites DoctorMedicineFavorite[]
  usages    PrescriptionItem[]

  @@index([chamberId])
  @@map("medicines")
}

model DoctorMedicineFavorite {
  doctorId   String   @map("doctor_id") @db.Uuid
  medicineId String   @map("medicine_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  doctor   Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  medicine Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  @@id([doctorId, medicineId])
  @@map("doctor_medicine_favorites")
}

/// One prescription per consultation; content lives in immutable versions (spec §12).
model Prescription {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  chamberId      String             @map("chamber_id") @db.Uuid
  patientId      String             @map("patient_id") @db.Uuid
  doctorId       String             @map("doctor_id") @db.Uuid
  consultationId String             @unique @map("consultation_id") @db.Uuid
  /// Assigned on first finalization, e.g. RX-000145 (unique per chamber).
  rxNumber       String?            @map("rx_number") @db.VarChar(20)
  status         PrescriptionStatus @default(DRAFT)
  currentVersion Int                @default(1) @map("current_version")
  issuedAt       DateTime?          @map("issued_at") @db.Timestamptz(3)
  isDemo         Boolean            @default(false) @map("is_demo")
  version        Int                @default(1)
  createdById    String?            @map("created_by") @db.Uuid
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  chamber      Chamber               @relation(fields: [chamberId], references: [id], onDelete: Restrict)
  patient      Patient               @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor       Doctor                @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  consultation Consultation          @relation(fields: [consultationId], references: [id], onDelete: Restrict)
  versions     PrescriptionVersion[]

  @@unique([chamberId, rxNumber])
  @@index([chamberId, issuedAt])
  @@index([patientId, createdAt])
  @@index([doctorId, createdAt])
  @@map("prescriptions")
}

model PrescriptionSequence {
  chamberId String @id @map("chamber_id") @db.Uuid
  lastValue Int    @default(0) @map("last_value")

  @@map("prescription_sequences")
}

model PrescriptionVersion {
  id                String                    @id @default(uuid()) @db.Uuid
  prescriptionId    String                    @map("prescription_id") @db.Uuid
  versionNumber     Int                       @map("version_number")
  status            PrescriptionVersionStatus @default(DRAFT)
  advice            String?                   @db.VarChar(2000)
  revisionReason    String?                   @map("revision_reason") @db.VarChar(500)
  createdById       String?                   @map("created_by") @db.Uuid
  createdByName     String?                   @map("created_by_name") @db.VarChar(150)
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedById       String?                   @map("updated_by") @db.Uuid
  updatedByName     String?                   @map("updated_by_name") @db.VarChar(150)
  updatedAt         DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  finalizedAt       DateTime?                 @map("finalized_at") @db.Timestamptz(3)
  finalizedById     String?                   @map("finalized_by") @db.Uuid
  finalizedByName   String?                   @map("finalized_by_name") @db.VarChar(150)
  supersededAt      DateTime?                 @map("superseded_at") @db.Timestamptz(3)
  discardedAt       DateTime?                 @map("discarded_at") @db.Timestamptz(3)
  /// Random token for the public verification URL / QR code (spec §14).
  verificationToken String?                   @unique @map("verification_token") @db.VarChar(64)
  /// SHA-256 of the finalized content (tamper evidence).
  contentHash       String?                   @map("content_hash") @db.VarChar(64)

  prescription Prescription       @relation(fields: [prescriptionId], references: [id], onDelete: Restrict)
  items        PrescriptionItem[]

  @@unique([prescriptionId, versionNumber])
  @@map("prescription_versions")
}

model PrescriptionItem {
  id              String           @id @default(uuid()) @db.Uuid
  versionId       String           @map("version_id") @db.Uuid
  medicineId      String?          @map("medicine_id") @db.Uuid
  name            String           @db.VarChar(200)
  genericName     String?          @map("generic_name") @db.VarChar(200)
  strength        String?          @db.VarChar(80)
  form            MedicineForm?
  dose            String?          @db.VarChar(60)
  frequency       String?          @db.VarChar(60)
  route           MedicineRoute?
  durationValue   Int?             @map("duration_value")
  durationUnit    DurationUnit?    @map("duration_unit")
  quantity        Int?
  mealInstruction MealInstruction? @map("meal_instruction")
  timing          String?          @db.VarChar(100)
  instructions    String?          @db.VarChar(300)
  sortOrder       Int              @default(0) @map("sort_order")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  version  PrescriptionVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  medicine Medicine?           @relation(fields: [medicineId], references: [id], onDelete: Restrict)

  @@index([versionId])
  @@index([medicineId])
  @@map("prescription_items")
}

/// Reusable templates (spec §11): personal (doctor_id set) or chamber-wide (doctor_id NULL).
model PrescriptionTemplate {
  id                   String   @id @default(uuid()) @db.Uuid
  chamberId            String   @map("chamber_id") @db.Uuid
  doctorId             String?  @map("doctor_id") @db.Uuid
  name                 String   @db.VarChar(120)
  description          String?  @db.VarChar(300)
  /// [{ diagnosisId, name, code, isPrimary, certainty, note }]
  diagnoses            Json     @default("[]")
  /// [{ investigationId, name, instructions, priority }]
  investigations       Json     @default("[]")
  advice               String?  @db.VarChar(2000)
  followUpInstructions String?  @map("follow_up_instructions") @db.VarChar(500)
  createdById          String?  @map("created_by") @db.Uuid
  createdByName        String?  @map("created_by_name") @db.VarChar(150)
  version              Int      @default(1)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  chamber Chamber                    @relation(fields: [chamberId], references: [id], onDelete: Restrict)
  doctor  Doctor?                    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  items   PrescriptionTemplateItem[]

  @@index([chamberId])
  @@map("prescription_templates")
}

model PrescriptionTemplateItem {
  id              String           @id @default(uuid()) @db.Uuid
  templateId      String           @map("template_id") @db.Uuid
  medicineId      String?          @map("medicine_id") @db.Uuid
  name            String           @db.VarChar(200)
  genericName     String?          @map("generic_name") @db.VarChar(200)
  strength        String?          @db.VarChar(80)
  form            MedicineForm?
  dose            String?          @db.VarChar(60)
  frequency       String?          @db.VarChar(60)
  route           MedicineRoute?
  durationValue   Int?             @map("duration_value")
  durationUnit    DurationUnit?    @map("duration_unit")
  quantity        Int?
  mealInstruction MealInstruction? @map("meal_instruction")
  timing          String?          @db.VarChar(100)
  instructions    String?          @db.VarChar(300)
  sortOrder       Int              @default(0) @map("sort_order")

  template PrescriptionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@map("prescription_template_items")
}

// ───────────────────────── Billing (Phase 6) ─────────────────────────

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  VOID
}

enum InvoiceItemType {
  CONSULTATION
  FOLLOW_UP
  INVESTIGATION
  PROCEDURE
  OTHER
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE_BANKING
  BANK_TRANSFER
  OTHER
}

enum PaymentKind {
  PAYMENT
  REFUND
}

enum FeeItemKind {
  INVESTIGATION
  PROCEDURE
  OTHER
}

/// A bill for a visit (spec §18). Amounts are NUMERIC(12,2); totals are kept consistent by CHECK constraints.
model Invoice {
  id              String        @id @default(uuid()) @db.Uuid
  organizationId  String        @map("organization_id") @db.Uuid
  chamberId       String        @map("chamber_id") @db.Uuid
  patientId       String        @map("patient_id") @db.Uuid
  doctorId        String?       @map("doctor_id") @db.Uuid
  appointmentId   String?       @map("appointment_id") @db.Uuid
  invoiceNumber   String        @map("invoice_number") @db.VarChar(20)
  status          InvoiceStatus @default(UNPAID)
  subtotal        Decimal       @db.Decimal(12, 2)
  discountAmount  Decimal       @default(0) @map("discount_amount") @db.Decimal(12, 2)
  discountPercent Decimal?      @map("discount_percent") @db.Decimal(5, 2)
  discountReason  String?       @map("discount_reason") @db.VarChar(300)
  total           Decimal       @db.Decimal(12, 2)
  /// Net amount received: payments minus refunds.
  paidAmount      Decimal       @default(0) @map("paid_amount") @db.Decimal(12, 2)
  refundedAmount  Decimal       @default(0) @map("refunded_amount") @db.Decimal(12, 2)
  dueAmount       Decimal       @map("due_amount") @db.Decimal(12, 2)
  notes           String?       @db.VarChar(500)
  issuedAt        DateTime      @default(now()) @map("issued_at") @db.Timestamptz(3)
  voidedAt        DateTime?     @map("voided_at") @db.Timestamptz(3)
  voidedById      String?       @map("voided_by") @db.Uuid
  voidReason      String?       @map("void_reason") @db.VarChar(300)
  isDemo          Boolean       @default(false) @map("is_demo")
  version         Int           @default(1)
  createdById     String?       @map("created_by") @db.Uuid
  createdByName   String?       @map("created_by_name") @db.VarChar(150)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  chamber     Chamber       @relation(fields: [chamberId], references: [id], onDelete: Restrict)
  patient     Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor      Doctor?       @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  appointment Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  items       InvoiceItem[]
  payments    Payment[]

  @@unique([chamberId, invoiceNumber])
  @@index([chamberId, issuedAt])
  @@index([patientId, issuedAt])
  @@index([doctorId, issuedAt])
  @@index([chamberId, status])
  @@index([appointmentId])
  @@map("invoices")
}

model InvoiceItem {
  id          String          @id @default(uuid()) @db.Uuid
  invoiceId   String          @map("invoice_id") @db.Uuid
  type        InvoiceItemType
  description String          @db.VarChar(200)
  quantity    Int             @default(1)
  unitPrice   Decimal         @map("unit_price") @db.Decimal(12, 2)
  amount      Decimal         @db.Decimal(12, 2)
  feeItemId   String?         @map("fee_item_id") @db.Uuid
  sortOrder   Int             @default(0) @map("sort_order")

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  feeItem FeeItem? @relation(fields: [feeItemId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@map("invoice_items")
}

/// Payments and refunds are append-only ledger entries (never updated or deleted).
model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  invoiceId      String        @map("invoice_id") @db.Uuid
  chamberId      String        @map("chamber_id") @db.Uuid
  kind           PaymentKind   @default(PAYMENT)
  receiptNumber  String        @map("receipt_number") @db.VarChar(20)
  amount         Decimal       @db.Decimal(12, 2)
  method         PaymentMethod
  provider       String?       @db.VarChar(60)
  reference      String?       @db.VarChar(100)
  note           String?       @db.VarChar(300)
  reason         String?       @db.VarChar(300)
  receivedById   String?       @map("received_by") @db.Uuid
  receivedByName String?       @map("received_by_name") @db.VarChar(150)
  receivedAt     DateTime      @default(now()) @map("received_at") @db.Timestamptz(3)
  isDemo         Boolean       @default(false) @map("is_demo")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([chamberId, receiptNumber])
  @@index([invoiceId])
  @@index([chamberId, receivedAt])
  @@map("payments")
}

model BillingSequence {
  chamberId String @map("chamber_id") @db.Uuid
  kind      String @db.VarChar(20)
  lastValue Int    @default(0) @map("last_value")

  @@id([chamberId, kind])
  @@map("billing_sequences")
}

/// Chamber fee schedule for investigations, procedures and other charges.
model FeeItem {
  id              String      @id @default(uuid()) @db.Uuid
  chamberId       String      @map("chamber_id") @db.Uuid
  kind            FeeItemKind
  name            String      @db.VarChar(200)
  amount          Decimal     @db.Decimal(12, 2)
  investigationId String?     @map("investigation_id") @db.Uuid
  isActive        Boolean     @default(true) @map("is_active")
  createdById     String?     @map("created_by") @db.Uuid
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  chamber       Chamber               @relation(fields: [chamberId], references: [id], onDelete: Restrict)
  investigation InvestigationCatalog? @relation(fields: [investigationId], references: [id], onDelete: Restrict)
  invoiceItems  InvoiceItem[]

  @@index([chamberId])
  @@map("fee_items")
}
