{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "dist",
    "rootDir": "src",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "declaration": false,
    "strictPropertyInitialization": false,
    "noImplicitOverride": true,
    "useUnknownInCatchVariables": true,
    "incremental": true
  },
  "include": ["src"]
}
