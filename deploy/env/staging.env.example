# Chamber Assistant — staging environment. Copy to env/staging.env (git-ignored).
# Secrets are NOT set here: they live in deploy/secrets/* (see make-secrets.sh).
DEPLOY_ENV=staging
NODE_ENV=staging
APP_VERSION=0.8.0

# Public host name; Caddy obtains a TLS certificate for it automatically.
SITE_DOMAIN=staging.chamber.example.com

# First super administrator (created once by the migrate job; must change password).
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_NAME=Platform Administrator

LOG_LEVEL=log
SLOW_QUERY_MS=300
RATE_LIMIT_PER_MINUTE=300
LOGIN_RATE_LIMIT_PER_MINUTE=10

# Backups: daily at BACKUP_TIME (UTC), verified by a test restore every time.
BACKUP_TIME=02:30
BACKUP_KEEP_DAILY=3
BACKUP_KEEP_WEEKLY=2
BACKUP_KEEP_MONTHLY=1
BACKUP_HOST_DIR=./backups
# Off-site copy, e.g. with rclone configured on the host: rclone copy {} offsite:chamber-backups/
BACKUP_UPLOAD_CMD=
